# Air configuration for live-reloading Go server
root = "."
tmp_dir = "tmp"

[build]
  # Build command
  cmd = "go build -o ./tmp/main ."
  # Binary to run
  bin = "./tmp/main"
  # Watch these extensions
  include_ext = ["go", "tpl", "tmpl", "html", "css"]
  # Exclude these directories
  exclude_dir = ["tmp", "node_modules", "vendor", "modules/*/static", "modules/*/node_modules"]
  # Delay after file change (ms)
  delay = 1000

[run]
  # Environment variables for the running process
  env = ["APP_ENV=development"]

[log]
  # Show log time
  time = false

[color]
  # Build color
  main = "magenta"
  watcher = "cyan"
  build = "yellow"
  runner = "green"

[misc]
  # Delete tmp directory on exit
  clean_on_exit = true
